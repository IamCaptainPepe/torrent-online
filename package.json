{
  "name": "torrent-online",
  "version": "1.7.13",
  "type": "module",
  "description": "Stream .torrent / magnet to VLC or browser — torrent streaming for macOS/Linux without a torrent client. Стрим торрентов в VLC или браузер.",
  "keywords": [
    "torrent",
    "magnet",
    "streaming",
    "vlc",
    "webtorrent",
    "macos",
    "linux",
    "cli",
    "rutor",
    "piratebay"
  ],
  "license": "MIT",
  "author": "IamCaptainPepe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamCaptainPepe/torrent-online.git"
  },
  "homepage": "https://github.com/IamCaptainPepe/torrent-online#readme",
  "bugs": {
    "url": "https://github.com/IamCaptainPepe/torrent-online/issues"
  },
  "bin": {
    "torrent-online": "./wtui.js"
  },
  "files": [
    "wtui.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/menu.png",
    "vendor/ip-set"
  ],
  "scripts": {
    "start": "node wtui.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "hls.js": "^1.5.17",
    "ip-set": "file:vendor/ip-set",
    "webtorrent": "^3.0.21"
  },
  "overrides": {
    "ip-set": "$ip-set"
  },
  "bundleDependencies": [
    "ip-set",
    "webtorrent"
  ],
  "engines": {
    "node": ">=18"
  }
